version = 1

# Locmetry's policy for measuring itself; docs/self-measurement.md explains
# every decision and how to verify it. Category names come from the category
# reference (locmetry --guide categories).
#
# Built-in detection already decides most files: Cargo inference makes src/
# production, and the test conventions make tests/, src/**/tests.rs and
# scripts/test_*.py tests. This file adds only what the built-ins cannot know:
# - [[rules]] give a purpose to the scripts no build descriptor declares. They
#   name known responsibilities instead of claiming all of scripts/, so a new
#   script surfaces as unclaimed source for review.
# - [[refinements]] give the conventional tests a finer category without
#   touching their purpose.
# - There are no [[overrides]]: no decision here has to beat a convention.
# Every entry is limited to source files and records its evidence as `reason`.

[scope]
# The synthetic application is measurement input, not Locmetry's own code.
exclude = ["examples/cli-workspace/**"]

[categories]
tooling = "Commands that serve the people working on the repository: documentation maintenance and measurement review"
distribution = "Publishing releases: packaging, installation definitions, notice generation and the release command"
verification-tooling = "Programs that run, prepare or score tests and checks without being one"
unit = "Tests of one module in process"
integration = "Tests that run the built executable, a script or Git as a process"
test-support = "Test code without test cases"

# Maintained programs are production even though the executable does not ship
# them. A program with unit tests of its own is code under test.

# The comparison helper ships in release archives and Homebrew installations,
# so it is part of the product, although no build descriptor declares it.
[[rules]]
id = "comparison-helper"
match = ["scripts/compare-locmetry-files.sh"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Installed with the executable for file-level report comparison. See [comparison](docs/guides/compare.md#inspect-configuration-transitions) and the release archives in [distribution](docs/tokei-integration.md)"

[[rules]]
id = "repository-tooling"
match = [
    "scripts/doc-indexes.py",
    "scripts/refresh-readme-showcase.py",
    "scripts/record-demo.sh",
    "scripts/agent-regression-trend.py",
]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "These commands maintain documentation and its showcase assets. See [documentation maintenance](docs/documentation-maintenance.md)"

[[rules]]
id = "distribution"
match = ["packaging/**", "scripts/release.py"]
except = ["packaging/linux/verify-packages.sh"]
kind = ["source"]
purpose = "production"
category = "distribution"
reason = "Packaging, notice generation and the release command, which checks, commits, tags and pushes a release. See [distribution](docs/tokei-integration.md)"

[[rules]]
id = "verification-tooling"
match = [
    "scripts/check-file-sizes.py",
    "scripts/check-recorded-guides.py",
    "scripts/cli-demo-env.sh",
    "scripts/fetch-showcase.sh",
    "scripts/showcase-env.sh",
    "scripts/agent-explorability.py",
    "scripts/agent-routing-study.py",
    "scripts/full-help-study.py",
    "scripts/score_agent_explorability.py",
    "scripts/score_full_help.py",
    "scripts/verify_help_recipe.py",
]
kind = ["source"]
purpose = "production"
category = "verification-tooling"
reason = "These programs run, prepare or score documentation and agent-workflow checks, and their own unit tests test them. See [self-measurement design](docs/self-measurement.md)"

# These checks fail on a mismatch, as tests do, but no test convention
# recognizes their names, so a rule decides both purpose and category.
[[rules]]
id = "executable-checks"
match = ["scripts/check-doc-examples.sh", "packaging/linux/verify-packages.sh"]
kind = ["source"]
purpose = "test"
category = "integration"
reason = "Run the documented examples with the built executable, or install each Linux package in a clean container and run it, and fail on a mismatch, as integration tests do. See [self-measurement design](docs/self-measurement.md)"

# The test conventions decide that these files are tests; refinements only say
# which kind of test, so Test/prod stays exactly what the conventions give.
# The exceptions state which files belong to another refinement, instead of
# relying on refinement order.

[[refinements]]
id = "unit-tests"
purpose = "test"
match = [
    "src/**/tests.rs",
    "scripts/test_agent_regression_trend.py",
    "scripts/test_score_full_help.py",
]
kind = ["source"]
category = "unit"
reason = "Rust unit test modules, which the rust-test-module convention recognizes, and the two script tests that import their module and mock every process"

[[refinements]]
id = "integration-tests"
purpose = "test"
match = ["tests/integration/**", "scripts/test_*.py"]
except = [
    "tests/integration/common.rs",
    "scripts/test_agent_regression_trend.py",
    "scripts/test_score_full_help.py",
]
kind = ["source"]
category = "integration"
reason = "The integration-test binary runs the built executable on synthetic projects; the other script tests run their script or Git as a process"

[[refinements]]
id = "integration-test-helpers"
purpose = "test"
match = ["tests/integration/common.rs"]
kind = ["source"]
category = "test-support"
reason = "Helpers shared by the integration tests, with no test of their own"
