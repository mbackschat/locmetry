version = 1

[scope]
# The synthetic application is measurement input; see [self-measurement design](docs/self-measurement.md).
exclude = ["examples/cli-workspace/**"]

[categories]
tooling = "Commands that maintain the repository, prepare releases and review measurements"
distribution = "Packaging, installation and third-party notice generation"
test-infrastructure = "Execution, preparation and evaluation of verification workflows"

[[rules]]
id = "repository-tooling"
match = [
    "scripts/doc-indexes.py",
    "scripts/release.py",
    "scripts/compare-locmetry-files.sh",
    "scripts/refresh-readme-showcase.py",
]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "These commands maintain documentation, prepare releases or review saved measurements; see [documentation maintenance](docs/documentation-maintenance.md), [distribution](docs/tokei-integration.md) and [comparison](docs/guides/compare.md)"

[[rules]]
id = "distribution"
match = ["packaging/**"]
kind = ["source"]
purpose = "production"
category = "distribution"
reason = "Maintained packaging and notice-generation source supports installation and distribution; see [distribution](docs/tokei-integration.md)"

[[rules]]
id = "verification-infrastructure"
match = [
    "scripts/check-doc-examples.sh",
    "scripts/check-file-sizes.py",
    "scripts/check-recorded-guides.py",
    "scripts/cli-demo-env.sh",
    "scripts/fetch-showcase.sh",
    "scripts/showcase-env.sh",
    "scripts/agent-explorability.py",
    "scripts/agent-routing-study.py",
    "scripts/full-help-study.py",
    "scripts/score_agent_explorability.py",
    "scripts/score_full_help.py",
    "scripts/verify_help_recipe.py",
]
kind = ["source"]
purpose = "test"
category = "test-infrastructure"
reason = "These scripts prepare, execute or assess documentation and agent-workflow checks; see [self-measurement design](docs/self-measurement.md)"
