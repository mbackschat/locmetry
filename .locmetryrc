version = 1

# Locmetry's policy for measuring itself; docs/self-measurement.md explains
# every decision and how to verify it.
#
# Built-in detection already decides most files: Cargo inference makes src/
# production, and the test conventions make tests/, src/**/tests.rs and
# scripts/test_*.py tests. This file adds only what the built-ins cannot know:
# - [[rules]] give a purpose to the scripts no build descriptor declares. They
#   name known responsibilities instead of claiming all of scripts/, so a new
#   script surfaces as unclaimed source for review.
# - [[refinements]] give the conventional tests a finer category without
#   touching their purpose.
# - There are no [[overrides]]: no decision here has to beat a convention.
# Every entry is limited to source files and records its evidence as `reason`.

[scope]
# The synthetic application is measurement input, not Locmetry's own code.
exclude = ["examples/cli-workspace/**"]

[categories]
tooling = "Commands that maintain the repository, prepare releases and review measurements"
distribution = "Packaging, installation and third-party notice generation"
verification-tooling = "Programs that run, prepare or score verification workflows"
unit = "Rust unit tests of the library's modules"
integration = "Tests that run the built executable on synthetic projects"
tooling-test = "Unit tests of the repository's own scripts"
documentation-check = "Checks that documented examples still produce what the documents say"

# Maintained programs are production even though the executable does not ship
# them. A program with unit tests of its own is code under test.

[[rules]]
id = "repository-tooling"
match = [
    "scripts/doc-indexes.py",
    "scripts/release.py",
    "scripts/compare-locmetry-files.sh",
    "scripts/refresh-readme-showcase.py",
    "scripts/record-demo.sh",
    "scripts/agent-regression-trend.py",
]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "These commands maintain documentation, prepare releases or review saved measurements. See [documentation maintenance](docs/documentation-maintenance.md), [distribution](docs/tokei-integration.md) and [comparison](docs/guides/compare.md)"

[[rules]]
id = "distribution"
match = ["packaging/**"]
kind = ["source"]
purpose = "production"
category = "distribution"
reason = "Maintained packaging and notice-generation source supports installation and distribution. See [distribution](docs/tokei-integration.md)"

[[rules]]
id = "verification-tooling"
match = [
    "scripts/check-file-sizes.py",
    "scripts/check-recorded-guides.py",
    "scripts/cli-demo-env.sh",
    "scripts/fetch-showcase.sh",
    "scripts/showcase-env.sh",
    "scripts/agent-explorability.py",
    "scripts/agent-routing-study.py",
    "scripts/full-help-study.py",
    "scripts/score_agent_explorability.py",
    "scripts/score_full_help.py",
    "scripts/verify_help_recipe.py",
]
kind = ["source"]
purpose = "production"
category = "verification-tooling"
reason = "These programs run, prepare or score documentation and agent-workflow checks, and their own unit tests test them. See [self-measurement design](docs/self-measurement.md)"

# The documentation check fails on a mismatch, as a test does, but no test
# convention recognizes its name, so a rule decides both purpose and category.
[[rules]]
id = "documentation-checks"
match = ["scripts/check-doc-examples.sh"]
kind = ["source"]
purpose = "test"
category = "documentation-check"
reason = "Runs the documented examples and fails on a mismatch, as an integration test does. See [self-measurement design](docs/self-measurement.md)"

# The test conventions decide that these files are tests; refinements only say
# which kind of test, so Test/prod stays exactly what the conventions give.

[[refinements]]
id = "unit-tests"
purpose = "test"
match = ["src/**/tests.rs"]
kind = ["source"]
category = "unit"
reason = "Out-of-line unit test modules of the library, which the rust-test-module convention recognizes"

[[refinements]]
id = "integration-tests"
purpose = "test"
match = ["tests/integration/**"]
kind = ["source"]
category = "integration"
reason = "The single integration-test binary, which runs the built executable on synthetic projects"

[[refinements]]
id = "tooling-tests"
purpose = "test"
match = ["scripts/test_*.py"]
kind = ["source"]
category = "tooling-test"
reason = "Unit tests of the maintenance and verification scripts above"
