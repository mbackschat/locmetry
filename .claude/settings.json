{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/prune-target.py\" --hook",
            "timeout": 120,
            "statusMessage": "Pruning old build units"
          }
        ]
      }
    ]
  }
}
