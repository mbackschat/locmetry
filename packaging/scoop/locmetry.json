{
    "version": "{{version}}",
    "description": "Measure source code by language, folder, and purpose",
    "homepage": "https://github.com/mbackschat/locmetry",
    "license": "MIT",
    "notes": "compare-locmetry-files.sh is in $dir and needs Bash and jq.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mbackschat/locmetry/releases/download/v{{version}}/locmetry-v{{version}}-x86_64-pc-windows-msvc.zip",
            "hash": "{{sha256_x86_64_pc_windows_msvc}}",
            "extract_dir": "locmetry-v{{version}}-x86_64-pc-windows-msvc"
        }
    },
    "bin": "locmetry.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mbackschat/locmetry/releases/download/v$version/locmetry-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "locmetry-v$version-x86_64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
