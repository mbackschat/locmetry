version = 1

[scope]
hidden = false
exclude = ["service/third_party/**"]

[categories]
tooling = "Maintained developer commands"
generated = "Committed generator output, regenerated rather than edited"

[[languages.mappings]]
id = "receipt-templates"
match = ["web/src/**/*.acmetpl"]
language = "HTML"

[[overrides]]
id = "generated-client"
match = ["web/src/api/client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: Code generated by acme-openapi. DO NOT EDIT."

[[rules]]
id = "tooling"
match = ["service/scripts/**"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Maintained check script that developers run before a commit"
