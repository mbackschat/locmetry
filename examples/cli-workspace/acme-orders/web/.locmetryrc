version = 1

[scope]
hidden = false

[categories]
generated = "Committed generator output, regenerated rather than edited"

[[languages.mappings]]
id = "receipt-templates"
match = ["src/**/*.acmetpl"]
language = "HTML"

[[overrides]]
id = "generated-client"
match = ["src/api/client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: Code generated by acme-openapi. DO NOT EDIT."
