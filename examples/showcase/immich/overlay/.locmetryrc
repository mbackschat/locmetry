version = 1

# Locmetry's reviewed policy for the whole Immich checkout; upstream ships no
# Locmetry configuration. workspace.toml measures six folders of the checkout
# under this same policy. The showcase README explains each decision and how
# to review a change: examples/showcase/immich/README.md. Category names come
# from the category reference (locmetry --guide categories).
#
# Each entry uses the weakest stage that expresses its decision:
# - [[rules]] claim code the built-ins leave unclaimed or count with the wrong
#   purpose. They come after the test and build conventions, so they never
#   turn a conventional test or build script into something else.
# - [[refinements]] only relabel files whose purpose is already decided.
# - There are no [[overrides]]: no decision here has to beat a convention.
# Every entry is limited to source files and records its evidence as `reason`,
# which reports and `locmetry explain` show.

[categories]
generated = "Committed generator output that the owner excludes from product totals"
end-to-end = "Workflows through the running server and web client with their real services"
integration = "Web-client suites against mocked API responses"
test-support = "Test code without test cases: helpers, fixtures, generators, mocks and stand-in services"
performance = "Load workloads against a running service"
native = "The iOS and Android shells around the Flutter app"
deployment = "Container images, start scripts, infrastructure definitions and the installer"
documentation-site = "Configuration, pages, components and theme of the documentation site"
distribution = "The release command, which bumps versions across the checkout and drafts release notes"
tooling = "Development containers and maintained developer commands"

# Generated code. Purpose `other` takes it out of production totals.

# A rule suffices to take a file from the npm module layout: rules apply before
# build modules, and no test or build convention claims generated sources.
[[rules]]
id = "generated-sdk-client"
match = ["packages/sdk/src/fetch-client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: DO NOT MODIFY, generated using oazapfts from the OpenAPI specification"

[[rules]]
id = "generated-query-snapshots"
match = ["server/src/queries/**"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: auto generated by ./sql-generator. Snapshots of repository queries"

# Test code that the npm module layouts would count as production.

# The rule makes the helpers, fixtures and generators of the suites tests. Their
# *.e2e-spec.ts files are tests by the built-in convention first, which the
# report lists as `preempted`. The refinements below then name the kind of each
# file, so the rule only decides the purpose.
[[rules]]
id = "end-to-end-suites"
match = ["e2e/src/**"]
kind = ["source"]
purpose = "test"
reason = "Playwright and API suites with their fixtures, generators and utilities"

[[rules]]
id = "end-to-end-auth-server"
match = ["packages/e2e-auth-server/**"]
kind = ["source"]
purpose = "test"
category = "test-support"
reason = "OAuth provider stand-in used only by the end-to-end suites"

[[rules]]
id = "load-tests"
match = ["machine-learning/locustfile.py"]
kind = ["source"]
purpose = "test"
category = "performance"
reason = "Locust load test for the machine-learning service"

# Maintained code that no build descriptor declares, so no stage claims it.

[[rules]]
id = "pigeon-definitions"
match = ["mobile/pigeon/**"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Pigeon definitions from which the Dart, Kotlin and Swift platform bindings are generated"

[[rules]]
id = "plugin-sdk-command"
match = ["packages/plugin-sdk/plugin-sdk.mjs"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Declared as the package's bin entry in packages/plugin-sdk/package.json"

# A rule claims the iOS code because no Package.swift declares it, so it would
# otherwise stay unclaimed. The Android code is module source and only needs
# the android-app refinement below.
[[rules]]
id = "ios-app"
match = ["mobile/ios/**/*.swift", "mobile/ios/**/*.h"]
kind = ["source"]
purpose = "production"
category = "native"
reason = "Swift code and headers of the iOS runner and its extensions. No Package.swift declares it"

# The auth server's Dockerfile belongs to its test support. The exception
# states that here instead of relying on end-to-end-auth-server coming first.
# Compose files under docker/ are data, which source rules do not classify, so
# the folder needs no glob.
[[rules]]
id = "deployment"
match = [
    "**/Dockerfile",
    "deployment/**",
    "install.sh",
    "machine-learning/scripts/**",
    "server/bin/**",
    "web/bin/**",
]
except = ["packages/e2e-auth-server/**"]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Container images and start scripts, Terraform modules and the installer of self-hosted installations"

# Built-in conventions already classify the configuration of named tools, such
# as vite.config.ts or vitest.config.ts. These rules name only what they do
# not. mobile/bin/ is part of the Dart module layout, which the report lists
# as `displaced` production:implementation.
[[rules]]
id = "build-scripts"
match = [
    "packages/*/esbuild.js",
    "web/lint-env.js",
    "mobile/ios/scripts/xcode_flutter_build.sh",
]
kind = ["source"]
purpose = "production"
category = "build-tooling"
reason = "Bundler and linter configuration and the Xcode build phase that runs the Flutter build"

[[rules]]
id = "documentation-site"
match = ["docs/docusaurus.config.js", "docs/sidebars.js"]
kind = ["source"]
purpose = "production"
category = "documentation-site"
reason = "Docusaurus configuration and sidebars of the documentation site"

# The build script is excepted from the scripts folder because build-scripts
# decides it.
[[rules]]
id = "developer-tooling"
match = [
    ".devcontainer/**",
    ".pnpmfile.cjs",
    "mobile/bin/**",
    "mobile/ios/ci_scripts/**",
    "mobile/ios/scripts/**",
    "mobile/scripts/**",
    "open-api/bin/**",
]
except = ["mobile/ios/scripts/xcode_flutter_build.sh"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Development containers and maintained developer commands"

# Refinements change only the category, so purpose totals and module credit
# stay as the built-ins and rules decided them.

# The Gradle module layout already counts the Android runner as production.
[[refinements]]
id = "android-app"
purpose = "production"
match = ["mobile/android/app/src/main/**"]
kind = ["source"]
category = "native"
reason = "Kotlin, Java and C code of the Android runner, which the Gradle layout labels implementation"

# The npm module layouts label these implementation, but neither is product
# functionality: one publishes releases, the other is the documentation site.
[[refinements]]
id = "release-scripts"
purpose = "production"
match = ["packages/scripts/src/**"]
kind = ["source"]
category = "distribution"
reason = "The repository's release command in packages/scripts/src/cli.ts: it bumps versions across the checkout and, in the showcase release, also drafts release notes"

[[refinements]]
id = "documentation-site-pages"
purpose = "production"
match = ["docs/src/**"]
kind = ["source"]
category = "documentation-site"
reason = "Pages, components, styles and theme overrides of the Docusaurus documentation site"

# The suites under e2e/src/specs/ drive the running server and web client
# without mocks. Every web-client spec under e2e/src/ui/specs/ mocks the API
# through e2e/src/ui/mock-network/, so it tests short of the whole system. The
# remaining files hold no test cases. The refinements apply whether the test
# convention or the end-to-end-suites rule made a file a test.
[[refinements]]
id = "end-to-end"
purpose = "test"
match = ["e2e/src/specs/**"]
kind = ["source"]
category = "end-to-end"
reason = "Playwright and API suites against the running server and web client"

[[refinements]]
id = "web-client-integration"
purpose = "test"
match = ["e2e/src/ui/specs/**/*.e2e-spec.ts"]
kind = ["source"]
category = "integration"
reason = "Playwright suites of the web client that mock API responses through e2e/src/ui/mock-network"

[[refinements]]
id = "end-to-end-support"
purpose = "test"
match = ["e2e/src/**"]
except = ["e2e/src/specs/**", "e2e/src/ui/specs/**/*.e2e-spec.ts"]
kind = ["source"]
category = "test-support"
reason = "Fixtures, generators, API response mocks and helpers of the suites, with no test cases"

[[languages.corrections]]
id = "release-notes-template"
match = ["misc/release/notes.tmpl"]
language = "Markdown"
reason = "Markdown release-notes template with a placeholder, which the counter reads as Templ by its .tmpl extension"
