version = 1

# Locmetry's reviewed policy for the whole Immich checkout; upstream ships no
# Locmetry configuration. workspace.toml measures six folders of the checkout
# under this same policy. The showcase README explains each decision and how
# to review a change: examples/showcase/immich/README.md.
#
# Each entry uses the weakest stage that expresses its decision:
# - [[rules]] claim code the built-ins leave unclaimed or count with the wrong
#   purpose. They come after the test and build conventions, so they never
#   turn a conventional test or build script into something else.
# - [[refinements]] only relabel files whose purpose is already decided.
# - There are no [[overrides]]: no decision here has to beat a convention.
# Every entry is limited to source files and records its evidence as `reason`,
# which reports and `locmetry explain` show.

[categories]
generated = "Committed generator output, regenerated rather than edited by hand"
end-to-end = "Suites that drive a running server and web client"
test-infrastructure = "Services that exist only to run tests"
performance-test = "Load tests against a running service"
native = "Platform code of the iOS and Android apps"
deployment = "Container images, start scripts, infrastructure definitions and the installer"
tooling = "Developer commands and build, bundling and lint configuration"

# Generated code. Purpose `other` takes it out of production totals.

# A rule suffices to take a file from the npm module layout: rules apply before
# build modules, and no test or build convention claims generated sources.
[[rules]]
id = "generated-sdk-client"
match = ["packages/sdk/src/fetch-client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: DO NOT MODIFY, generated using oazapfts from the OpenAPI specification"

[[rules]]
id = "generated-query-snapshots"
match = ["server/src/queries/**"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: auto generated by ./sql-generator. Snapshots of repository queries"

# Test code that the npm module layouts would count as production.

# The rule makes the helpers, fixtures and generators of the suites tests. Their
# *.e2e-spec.ts files are tests by the built-in convention first, which the
# report lists as `preempted`. The end-to-end refinement below then gives all
# of them one category, so the rule only decides the purpose.
[[rules]]
id = "end-to-end-suites"
match = ["e2e/src/**"]
kind = ["source"]
purpose = "test"
reason = "Playwright and API suites with their fixtures, generators and utilities"

[[rules]]
id = "end-to-end-auth-server"
match = ["packages/e2e-auth-server/**"]
kind = ["source"]
purpose = "test"
category = "test-infrastructure"
reason = "OAuth provider stand-in used only by the end-to-end suites"

[[rules]]
id = "load-tests"
match = ["machine-learning/locustfile.py"]
kind = ["source"]
purpose = "test"
category = "performance-test"
reason = "Locust load test for the machine-learning service"

# Maintained code that no build descriptor declares, so no stage claims it.

[[rules]]
id = "pigeon-definitions"
match = ["mobile/pigeon/**"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Pigeon definitions from which the Dart, Kotlin and Swift platform bindings are generated"

[[rules]]
id = "plugin-sdk-command"
match = ["packages/plugin-sdk/plugin-sdk.mjs"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Declared as the package's bin entry in packages/plugin-sdk/package.json"

# A rule claims the iOS code because no Package.swift declares it, so it would
# otherwise stay unclaimed. The Android code is module source and only needs
# the android-app refinement below.
[[rules]]
id = "ios-app"
match = ["mobile/ios/**/*.swift", "mobile/ios/**/*.h"]
kind = ["source"]
purpose = "production"
category = "native"
reason = "Swift code and headers of the iOS runner and its extensions. No Package.swift declares it"

# The auth server's Dockerfile belongs to its test infrastructure. The
# exception states that here instead of relying on end-to-end-auth-server
# coming first. Compose files under docker/ are data, which source rules do
# not classify, so the folder needs no glob.
[[rules]]
id = "deployment"
match = [
    "**/Dockerfile",
    "deployment/**",
    ".devcontainer/**",
    "install.sh",
    "machine-learning/scripts/**",
    "server/bin/**",
    "web/bin/**",
]
except = ["packages/e2e-auth-server/**"]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Container images and start scripts, Terraform modules, development containers and the installer"

# Built-in conventions already classify the configuration of named tools, such
# as vite.config.ts or vitest.config.ts. This list names only what they do not:
# the documentation site's configuration and maintained developer commands.
# mobile/bin/ is part of the Dart module layout, which the report lists as
# `displaced` production:implementation.
[[rules]]
id = "developer-tooling"
match = [
    "docs/docusaurus.config.js",
    "docs/sidebars.js",
    "packages/*/esbuild.js",
    "web/lint-env.js",
    ".pnpmfile.cjs",
    "mobile/bin/**",
    "mobile/ios/ci_scripts/**",
    "mobile/ios/scripts/**",
    "mobile/scripts/**",
    "open-api/bin/**",
    "misc/**",
]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Documentation-site and bundling configuration plus maintained developer commands"

# Refinements change only the category, so purpose totals and module credit
# stay as the built-ins and rules decided them.

# The Gradle module layout already counts the Android runner as production.
[[refinements]]
id = "android-app"
purpose = "production"
match = ["mobile/android/app/src/main/**"]
kind = ["source"]
category = "native"
reason = "Kotlin, Java and C code of the Android runner, which the Gradle layout labels implementation"

# One category for the end-to-end suites, whether the test convention or the
# end-to-end-suites rule made a file a test.
[[refinements]]
id = "end-to-end"
purpose = "test"
match = ["e2e/src/**"]
kind = ["source"]
category = "end-to-end"
reason = "Specs, helpers and fixtures of the Playwright and API suites"

[[languages.corrections]]
id = "proguard-rules"
match = ["mobile/android/app/proguard-rules.pro"]
language = "unrecognized"
reason = "ProGuard keep rules, which the counter reads as Prolog by their .pro extension. No counter language shares their syntax"
