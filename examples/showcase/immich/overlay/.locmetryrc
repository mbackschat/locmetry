version = 1

# Locmetry's policy for measuring the whole Immich checkout; upstream ships no
# Locmetry configuration. Member configurations express the same decisions
# relative to their own roots for workspace measurement.

[categories]
generated = "Committed generator output, regenerated rather than edited by hand"
end-to-end = "Suites that drive a running server and web client"
test-infrastructure = "Services that exist only to run tests"
performance-test = "Load tests against a running service"
native = "Platform code of the iOS app"
deployment = "Container images, start scripts, infrastructure definitions and the installer"
tooling = "Developer commands and build, bundling and lint configuration"

[[overrides]]
id = "generated-sdk-client"
match = ["packages/sdk/src/fetch-client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: DO NOT MODIFY, generated using oazapfts from the OpenAPI specification; beats the npm module layout"

[[overrides]]
id = "generated-query-snapshots"
match = ["server/src/queries/**"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: auto generated by ./sql-generator; snapshots of repository queries inside the npm module layout"

[[rules]]
id = "end-to-end-suites"
match = ["e2e/src/**"]
kind = ["source"]
purpose = "test"
category = "end-to-end"
reason = "Playwright and API suites with their fixtures, generators and utilities; the *.e2e-spec.ts files are already tests by convention"

[[rules]]
id = "end-to-end-auth-server"
match = ["packages/e2e-auth-server/**"]
kind = ["source"]
purpose = "test"
category = "test-infrastructure"
reason = "OAuth provider stand-in used only by the end-to-end suites"

[[rules]]
id = "load-tests"
match = ["machine-learning/locustfile.py"]
kind = ["source"]
purpose = "test"
category = "performance-test"
reason = "Locust load test for the machine-learning service"

[[rules]]
id = "pigeon-definitions"
match = ["mobile/pigeon/**"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Pigeon platform-channel definitions from which the Dart, Kotlin and Swift bindings are generated"

[[rules]]
id = "plugin-sdk-command"
match = ["packages/plugin-sdk/plugin-sdk.mjs"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Declared as the package's bin entry in packages/plugin-sdk/package.json"

[[rules]]
id = "ios-app"
match = ["mobile/ios/**"]
kind = ["source"]
purpose = "production"
category = "native"
reason = "Swift code of the iOS runner and widget extension; no Package.swift declares it"

[[rules]]
id = "deployment"
match = [
    "**/Dockerfile",
    "deployment/**",
    "docker/**",
    ".devcontainer/**",
    "install.sh",
    "machine-learning/scripts/**",
    "server/bin/**",
    "web/bin/**",
]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Container images and their start and health-check scripts, Terraform modules, development containers and the installer"

[[rules]]
id = "developer-tooling"
match = [
    "*/*.config.{js,cjs,mjs,ts}",
    "packages/*/*.config.{js,cjs,mjs,ts}",
    "packages/*/esbuild.js",
    "docs/sidebars.js",
    "web/lint-env.js",
    ".pnpmfile.cjs",
    "mobile/android/app/proguard-rules.pro",
    "mobile/bin/**",
    "mobile/scripts/**",
    "open-api/bin/**",
    "misc/**",
]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Build, bundling, lint and test-runner configuration plus maintained developer commands"
