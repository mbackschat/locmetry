version = 1

[categories]
generated = "Committed generator output, regenerated rather than edited by hand"
deployment = "Container image, start and health-check scripts"
tooling = "Build, lint and test-runner configuration"

[[overrides]]
id = "generated-query-snapshots"
match = ["src/queries/**"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: auto generated by ./sql-generator; snapshots of repository queries inside the npm module layout"

[[rules]]
id = "deployment"
match = ["Dockerfile", "bin/**"]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Container image with its start, health-check and administration entry scripts"

[[rules]]
id = "developer-tooling"
match = ["*.config.{js,cjs,mjs,ts}"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Build, lint and test-runner configuration"
