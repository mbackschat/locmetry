version = 1

[categories]
generated = "Committed generator output, regenerated rather than edited by hand"
test-infrastructure = "Services that exist only to run tests"
deployment = "Container image of the command-line client"
tooling = "Build, bundling and lint configuration"

[[overrides]]
id = "generated-sdk-client"
match = ["sdk/src/fetch-client.ts"]
kind = ["source"]
purpose = "other"
category = "generated"
reason = "Header: DO NOT MODIFY, generated using oazapfts from the OpenAPI specification; beats the npm module layout"

[[rules]]
id = "end-to-end-auth-server"
match = ["e2e-auth-server/**"]
kind = ["source"]
purpose = "test"
category = "test-infrastructure"
reason = "OAuth provider stand-in used only by the end-to-end suites"

[[rules]]
id = "plugin-sdk-command"
match = ["plugin-sdk/plugin-sdk.mjs"]
kind = ["source"]
purpose = "production"
category = "implementation"
reason = "Declared as the package's bin entry in plugin-sdk/package.json"

[[rules]]
id = "deployment"
match = ["*/Dockerfile"]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Container image of the command-line client"

[[rules]]
id = "developer-tooling"
match = ["*/*.config.{js,cjs,mjs,ts}", "*/esbuild.js"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Build, bundling and lint configuration"
