version = 1

[categories]
deployment = "Container start script"
tooling = "Build, bundling and lint configuration"

[[rules]]
id = "deployment"
match = ["bin/**"]
kind = ["source"]
purpose = "production"
category = "deployment"
reason = "Start script of the web container"

[[rules]]
id = "developer-tooling"
match = ["*.config.{js,cjs,mjs,ts}", "lint-env.js"]
kind = ["source"]
purpose = "production"
category = "tooling"
reason = "Build, bundling and lint configuration"
